#!/bin/sh
#
# @name project_quad (G4ZO x2 5-inch frame)
#
# @type Quadrotor
#
# GENERATED by simulation/tools/generate_model.py - edit parameters there.
# Mass 0.773 kg, AE2207 1960KV motors, 5.1-inch props, PX4 Quad X.
# Install into PX4: bash simulation/tools/px4_setup.sh
# (file is ASCII-only on purpose: PX4 build parses airframe metadata)
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=test_field}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=project_quad}

param set-default SIM_GZ_EN 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# Rotor geometry, PX4 body frame FRD (PY = -y of the SDF model)

param set-default CA_ROTOR0_PX 0.0750
param set-default CA_ROTOR0_PY 0.0875
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX -0.0750
param set-default CA_ROTOR1_PY -0.0875
param set-default CA_ROTOR1_KM 0.05

param set-default CA_ROTOR2_PX 0.0750
param set-default CA_ROTOR2_PY -0.0875
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.0750
param set-default CA_ROTOR3_PY 0.0875
param set-default CA_ROTOR3_KM -0.05

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_MIN1 70
param set-default SIM_GZ_EC_MAX1 1000

param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_MIN2 70
param set-default SIM_GZ_EC_MAX2 1000

param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_MIN3 70
param set-default SIM_GZ_EC_MAX3 1000

param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_MIN4 70
param set-default SIM_GZ_EC_MAX4 1000


# Hover: motors at 337 of 1000 scaled rad/s
# (sim speeds are scaled: 1000 = 3200 real rad/s).
# PX4 refines this in flight (hover thrust estimator).
param set-default MPC_THR_HOVER 0.29

# Rate controller global gains (PX4 defaults otherwise).
# Light 5-inch frame: with K=1 roll oscillation margin is only ~2.5x
# (offline check, tools/analysis/px4_stability.py); K=0.5 gives ~5x.
# If it oscillates - decrease K, if sluggish - increase.
param set-default MC_ROLLRATE_K 0.5
param set-default MC_PITCHRATE_K 0.5
param set-default MC_YAWRATE_K 1.0

param set-default NAV_DLL_ACT 2

# Simulation only: altitude from barometer, GPS altitude not fused
# (bit 1 of EKF2_GPS_CTRL off; 7 -> 5). With white GPS altitude noise in
# Gazebo the EKF shifts its global altitude reference, and mission altitude
# setpoints drifted 4.1-4.8 m instead of 5 m (flight 14.11). PX4 default is 7.
param set-default EKF2_GPS_CTRL 5
