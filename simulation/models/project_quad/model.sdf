<?xml version="1.0"?>
<!--
  project_quad v0.2 — цифровая модель квадрокоптера проекта.
  ФАЙЛ СГЕНЕРИРОВАН скриптом tools/generate_model.py — правьте параметры там.

  Геометрия: CAD-модель группы конструкторов (рама G4ZO x2, 5", диагональ 230,5 мм).
  Единицы СИ. Оси: X вперёд, Y влево, Z вверх. Начало — низ рамы, центр моторов.
  Порядок моторов: PX4 Quadrotor X.

  Общая масса: 0.753 кг. Из них оценки (нет в CAD):
       - Pixhawk 6C Mini: 39 г
       - бортовой компьютер (оценка): 45 г
       - радиомодем SiK 433 МГц: 25 г
       - модуль питания и провода: 30 г
       - GPS Holybro M9N + мачта: 40 г
       - лидар (тестовый, модель не выбрана): 50 г
-->
<sdf version="1.9">
  <model name="project_quad">
    <pose>0 0 0.02 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <pose>-0.00949 0.00000 0.03424 0 0 0</pose>
        <mass>0.67320</mass>
        <inertia>
          <ixx>1.874376e-03</ixx><ixy>1.868506e-08</ixy><ixz>2.950269e-04</ixz>
          <iyy>2.819126e-03</iyy><iyz>1.835437e-09</iyz>
          <izz>2.586108e-03</izz>
        </inertia>
      </inertial>
      <visual name="frame_base">
        <geometry><mesh><uri>model://project_quad/meshes/frame_base.stl</uri></mesh></geometry>
        <material><ambient>0.14 0.14 0.16 1</ambient><diffuse>0.14 0.14 0.16 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="frame_top">
        <geometry><mesh><uri>model://project_quad/meshes/frame_top.stl</uri></mesh></geometry>
        <material><ambient>0.22 0.22 0.25 1</ambient><diffuse>0.22 0.22 0.25 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="spacers">
        <geometry><mesh><uri>model://project_quad/meshes/spacers.stl</uri></mesh></geometry>
        <material><ambient>0.82 0.20 0.16 1</ambient><diffuse>0.82 0.20 0.16 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="cam_plates">
        <geometry><mesh><uri>model://project_quad/meshes/cam_plates.stl</uri></mesh></geometry>
        <material><ambient>0.31 0.31 0.63 1</ambient><diffuse>0.31 0.31 0.63 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="esc_fc">
        <geometry><mesh><uri>model://project_quad/meshes/esc_fc.stl</uri></mesh></geometry>
        <material><ambient>0.10 0.35 0.20 1</ambient><diffuse>0.10 0.35 0.20 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="esc_cap">
        <geometry><mesh><uri>model://project_quad/meshes/esc_cap.stl</uri></mesh></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="vtx">
        <geometry><mesh><uri>model://project_quad/meshes/vtx.stl</uri></mesh></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="rx">
        <geometry><mesh><uri>model://project_quad/meshes/rx.stl</uri></mesh></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="battery">
        <geometry><mesh><uri>model://project_quad/meshes/battery.stl</uri></mesh></geometry>
        <material><ambient>0.12 0.24 0.55 1</ambient><diffuse>0.12 0.24 0.55 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="camera">
        <geometry><mesh><uri>model://project_quad/meshes/camera.stl</uri></mesh></geometry>
        <material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="motor_stators">
        <geometry><mesh><uri>model://project_quad/meshes/motor_stators.stl</uri></mesh></geometry>
        <material><ambient>0.63 0.63 0.67 1</ambient><diffuse>0.63 0.63 0.67 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <!-- Заглушки компонентов, которых пока нет в CAD -->
      <visual name="gps_mast">
        <pose>-0.0650 0.0000 0.0657 0 0 0</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.0595</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="gps_puck">
        <pose>-0.0650 0.0000 0.1030 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.015</length></cylinder></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
      <visual name="lidar_body">
        <pose>0.0450 0.0000 0.0585 0 0 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.0450</length></cylinder></geometry>
        <material><ambient>0.9 0.75 0.1 1</ambient><diffuse>0.9 0.75 0.1 1</diffuse></material>
      </visual>

      <!-- Коллизия: пластина рамы + аккумулятор -->
      <collision name="frame_collision">
        <pose>0 0 0.0035 0 0 0</pose>
        <geometry><box><size>0.195 0.223 0.007</size></box></geometry>
      </collision>
      <collision name="battery_collision">
        <pose>-0.0225 0 0.0525 0 0 0</pose>
        <geometry><box><size>0.076 0.036 0.033</size></box></geometry>
      </collision>

      <!-- IMU (на Pixhawk 6C Mini). Имя imu_sensor — как ждёт PX4 SITL. -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.0003394</stddev><bias_mean>0</bias_mean><bias_stddev>3.8785e-05</bias_stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.0003394</stddev><bias_mean>0</bias_mean><bias_stddev>3.8785e-05</bias_stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.0003394</stddev><bias_mean>0</bias_mean><bias_stddev>3.8785e-05</bias_stddev></noise></z></angular_velocity>
          <linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev><bias_mean>0</bias_mean><bias_stddev>0.006</bias_stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev><bias_mean>0</bias_mean><bias_stddev>0.006</bias_stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev><bias_mean>0</bias_mean><bias_stddev>0.006</bias_stddev></noise></z></linear_acceleration>
        </imu>
      </sensor>

      <!-- Барометр (на Pixhawk 6C Mini) -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <reference_altitude>150</reference_altitude>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>1.5</stddev></noise></pressure>
        </air_pressure>
      </sensor>

      <!-- Магнитометр (компас в модуле GPS) -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <pose>-0.0650 0.0000 0.1030 0.0000 0.0000 0.0000</pose>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer><x><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev></noise></z></magnetometer>
      </sensor>

      <!-- GPS Holybro M9N -->
      <sensor name="navsat_sensor" type="navsat">
        <pose>-0.0650 0.0000 0.1030 0.0000 0.0000 0.0000</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <navsat>
          <position_sensing>
            <horizontal><noise type="gaussian"><mean>0</mean><stddev>6.288e-06</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0</mean><stddev>1.2</stddev></noise></vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></vertical>
          </velocity_sensing>
        </navsat>
      </sensor>

      <!-- Тестовый лидар (2D). Модель лидара ещё не выбрана электронщиками. -->
      <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>0.0450 0.0000 0.0850 0.0000 0.0000 0.0000</pose>
        <topic>project_quad/lidar</topic>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>

      <!-- Камера вниз 1280x720 (формат тестовых данных группы CV) -->
      <sensor name="down_camera" type="camera">
        <pose>0.0300 0.0000 0.0010 0.0000 1.5708 0.0000</pose>
        <topic>project_quad/camera_down/image</topic>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.2043</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>300</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
        </camera>
      </sensor>
    </link>

    <!-- Мотор 1 PX4 (rotor_0): передний правый, CCW -->
    <link name="rotor_0">
      <pose>0.0750 -0.0875 0.0050 0 0 0</pose>
      <inertial>
        <pose>0.00000 0.00000 0.01904 0 0 0</pose>
        <mass>0.01990</mass>
        <inertia>
          <ixx>4.569430e-06</ixx><ixy>0.000000e+00</ixy><ixz>0.000000e+00</ixz>
          <iyy>4.569430e-06</iyy><iyz>0.000000e+00</iyz>
          <izz>6.882481e-06</izz>
        </inertia>
      </inertial>
      <visual name="rotor_0_bell">
        <geometry><mesh><uri>model://project_quad/meshes/rotor_bell_ccw.stl</uri></mesh></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="rotor_0_prop">
        <geometry><mesh><uri>model://project_quad/meshes/rotor_prop_ccw.stl</uri></mesh></geometry>
        <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>2e-06</damping></dynamics>
      </axis>
    </joint>
    <!-- Мотор 2 PX4 (rotor_1): задний левый, CCW -->
    <link name="rotor_1">
      <pose>-0.0750 0.0875 0.0050 0 0 0</pose>
      <inertial>
        <pose>0.00000 0.00000 0.01904 0 0 0</pose>
        <mass>0.01990</mass>
        <inertia>
          <ixx>4.569430e-06</ixx><ixy>0.000000e+00</ixy><ixz>0.000000e+00</ixz>
          <iyy>4.569430e-06</iyy><iyz>0.000000e+00</iyz>
          <izz>6.882481e-06</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_bell">
        <geometry><mesh><uri>model://project_quad/meshes/rotor_bell_ccw.stl</uri></mesh></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="rotor_1_prop">
        <geometry><mesh><uri>model://project_quad/meshes/rotor_prop_ccw.stl</uri></mesh></geometry>
        <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>2e-06</damping></dynamics>
      </axis>
    </joint>
    <!-- Мотор 3 PX4 (rotor_2): передний левый, CW -->
    <link name="rotor_2">
      <pose>0.0750 0.0875 0.0050 0 0 0</pose>
      <inertial>
        <pose>0.00000 0.00000 0.01904 0 0 0</pose>
        <mass>0.01990</mass>
        <inertia>
          <ixx>4.569430e-06</ixx><ixy>0.000000e+00</ixy><ixz>0.000000e+00</ixz>
          <iyy>4.569430e-06</iyy><iyz>0.000000e+00</iyz>
          <izz>6.882481e-06</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_bell">
        <geometry><mesh><uri>model://project_quad/meshes/rotor_bell_cw.stl</uri></mesh></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="rotor_2_prop">
        <geometry><mesh><uri>model://project_quad/meshes/rotor_prop_cw.stl</uri></mesh></geometry>
        <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>2e-06</damping></dynamics>
      </axis>
    </joint>
    <!-- Мотор 4 PX4 (rotor_3): задний правый, CW -->
    <link name="rotor_3">
      <pose>-0.0750 -0.0875 0.0050 0 0 0</pose>
      <inertial>
        <pose>0.00000 0.00000 0.01904 0 0 0</pose>
        <mass>0.01990</mass>
        <inertia>
          <ixx>4.569430e-06</ixx><ixy>0.000000e+00</ixy><ixz>0.000000e+00</ixz>
          <iyy>4.569430e-06</iyy><iyz>0.000000e+00</iyz>
          <izz>6.882481e-06</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_bell">
        <geometry><mesh><uri>model://project_quad/meshes/rotor_bell_cw.stl</uri></mesh></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>
      <visual name="rotor_3_prop">
        <geometry><mesh><uri>model://project_quad/meshes/rotor_prop_cw.stl</uri></mesh></geometry>
        <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>2e-06</damping></dynamics>
      </axis>
    </joint>

    <!-- Моторы. Команды: топик /project_quad/command/motor_speed (см. tools/motors.sh) -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>3200.0</maxRotVelocity>
      <motorConstant>1.63e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>1e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-08</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10.0</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>3200.0</maxRotVelocity>
      <motorConstant>1.63e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>1e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-08</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10.0</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>3200.0</maxRotVelocity>
      <motorConstant>1.63e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>1e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-08</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10.0</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>3200.0</maxRotVelocity>
      <motorConstant>1.63e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>1e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-08</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10.0</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>
