# Результат обработки лидара. Тема: /uav/lidar_status (публикует lidar_processor)
# Углы: 0 = прямо по курсу дрона, положительные значения — влево (как в ROS)
std_msgs/Header header            # метка времени
bool scan_ok                      # true — лидар присылает данные; false — данных нет (LIDAR_LOST)
bool scan_used                    # false — скан пропущен: дрон наклонён сильнее допустимого
uint16 total_rays                 # сколько лучей в скане
uint16 valid_rays                 # сколько лучей вернули расстояние в рабочем диапазоне
float32 nearest_m                 # расстояние до ближайшего препятствия, м (-1.0 — препятствий нет)
float32 nearest_angle_deg         # направление на ближайшее препятствие, градусы (0, если препятствий нет)
float32 front_m                   # ближайшее препятствие спереди (от -45° до +45°), м; -1.0 — нет
float32 left_m                    # слева (от +45° до +135°), м; -1.0 — нет
float32 back_m                    # сзади (дальше ±135°), м; -1.0 — нет
float32 right_m                   # справа (от -135° до -45°), м; -1.0 — нет
uint8 level                       # 0 — норма, 1 — предупреждение, 2 — серьёзная проблема
string[] alerts                   # коды: OBSTACLE_NEAR, OBSTACLE_CLOSE, LIDAR_LOST; пустой список = норма
